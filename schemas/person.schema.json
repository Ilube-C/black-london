{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://black-london.app/schemas/person.json",
  "title": "Person",
  "type": "object",
  "required": ["name"],
  "properties": {
    "name": { "type": "string", "minLength": 2 },
    "birth_year": { "type": ["integer", "null"] },
    "death_year": { "type": ["integer", "null"] },
    "summary": { "type": "string" },
    "wikidata": { "type": ["string", "null"] },
    "image": { "type": ["object", "null"] }
  }
}
