{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://black-london.app/schemas/restaurant.schema.json",
  "title": "Restaurant",
  "type": "object",
  "required": ["id", "name", "cuisine", "borough", "status", "contributor", "verification"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string", "minLength": 2 },
    "cuisine": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "diaspora": { "type": "array", "items": { "type": "string" } },
    "borough": { "type": "string" },
    "address": { "type": ["string", "null"] },
    "phone": { "type": ["string", "null"] },
    "website": { "type": ["string", "null"], "format": "uri" },
    "opening_hours": { "type": ["string", "null"] },
    "price_band": { "enum": ["£", "££", "£££"] },
    "image": { "type": ["object", "null"] },
    "blurb": { "type": "string" },
    "related_themes": { "type": "array", "items": { "type": "string" } },
    "source": { "type": "string" },
    "contributor": { "$ref": "site.schema.json#/properties/contributor" },
    "verification": { "$ref": "site.schema.json#/properties/verification" },
    "status": { "enum": ["draft", "published", "retired"] }
  }
}
